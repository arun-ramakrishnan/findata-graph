{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontmatter.super_sector.v1.json",
  "x-template": "doc/templates/super_sector_note.yaml",
  "title": "Super-sector note frontmatter (v1)",
  "description": "Structural contract for findata/Super_Sectors/<Name>.md YAML frontmatter (9 live notes, 2026-08-17).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "normalized_name",
    "file_path",
    "permalink",
    "tags",
    "created",
    "last_modified"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical super-sector title (e.g. 'Consumer Discretionary')."
    },
    "type": {
      "const": "super_sector",
      "description": "Note type discriminator \u2014 always 'super_sector' in Super_Sectors/."
    },
    "normalized_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9&._\\- ]+$",
      "description": "Filename-derived canonical name; matches filename minus .md."
    },
    "file_path": {
      "type": "string",
      "pattern": "^findata/Super_Sectors/[A-Za-z0-9_.\\-]+\\.md$",
      "description": "Vault-relative path of this note (always present on super-sector notes)."
    },
    "permalink": {
      "type": "string",
      "pattern": "^/super_sectors/[a-z0-9_]+$",
      "description": "Stable identifier: /super_sectors/<super_sector_slug>."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
      },
      "description": "Namespaced lowercase tags (entity_type/super_sector, super_sector/<slug>)."
    },
    "created": {
      "$ref": "#/$defs/isoDate"
    },
    "last_modified": {
      "$ref": "#/$defs/isoDate"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "description": "OKF v0.2 \u00a75.2 \u2014 who wrote this content and when (provenance).",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "Actor convention: <producer>/<version> | human:<id> | process:<id>."
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt].*$",
          "description": "ISO 8601 datetime of last meaningful content change (UTC recommended)."
        }
      },
      "required": [
        "by",
        "at"
      ],
      "x-okf-version": "0.2"
    },
    "verified": {
      "type": "array",
      "description": "OKF v0.2 \u00a75.2/\u00a75.3 \u2014 independent confirmations. Array (never bare map) at write time.",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string",
            "minLength": 1,
            "description": "Verifier; human:<id> => human-reviewed trust tier."
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt].*$",
            "description": "ISO 8601 datetime of the verification."
          }
        },
        "required": [
          "by",
          "at"
        ]
      },
      "x-okf-version": "0.2"
    },
    "sources": {
      "type": "array",
      "description": "OKF v0.2 \u00a75.1 \u2014 materials this concept derives from.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable key; joins body footnotes [^id]."
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "description": "REQUIRED. URL or bundle-relative (/Reports/...) path."
          },
          "title": {
            "type": "string",
            "description": "Human-readable source title."
          },
          "author": {
            "type": "string",
            "description": "Optional OKF \u00a75.1 credibility signal (actor convention, \u00a77)."
          },
          "last_modified": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Credibility signal; YYYY-MM-DD."
          }
        },
        "required": [
          "id",
          "resource"
        ]
      },
      "x-okf-version": "0.2"
    },
    "status": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ],
      "description": "OKF v0.2 \u00a75.4 \u2014 lifecycle state; absent = stable.",
      "x-okf-version": "0.2"
    },
    "stale_after": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "OKF v0.2 \u00a75.5 \u2014 absolute stale date (YYYY-MM-DD); today >= stale_after => stale.",
      "x-okf-version": "0.2"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO calendar date (YYYY-MM-DD); PyYAML date objects are normalized before checking."
    }
  }
}
