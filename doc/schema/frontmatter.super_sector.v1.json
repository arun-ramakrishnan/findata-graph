{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontmatter.super_sector.v1.json",
  "title": "Super-sector note frontmatter (v1)",
  "description": "Structural contract for findata/Super_Sectors/<Name>.md YAML frontmatter (9 live notes, 2026-08-17).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "normalized_name",
    "file_path",
    "permalink",
    "tags",
    "created",
    "last_modified"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical super-sector title (e.g. 'Consumer Discretionary')."
    },
    "type": {
      "const": "super_sector",
      "description": "Note type discriminator \u2014 always 'super_sector' in Super_Sectors/."
    },
    "normalized_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9&._\\- ]+$",
      "description": "Filename-derived canonical name; matches filename minus .md."
    },
    "file_path": {
      "type": "string",
      "pattern": "^findata/Super_Sectors/[A-Za-z0-9_.\\-]+\\.md$",
      "description": "Vault-relative path of this note (always present on super-sector notes)."
    },
    "permalink": {
      "type": "string",
      "pattern": "^/super_sectors/[a-z0-9_]+$",
      "description": "Stable identifier: /super_sectors/<super_sector_slug>."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"
      },
      "description": "Namespaced lowercase tags (entity_type/super_sector, super_sector/<slug>)."
    },
    "created": {
      "$ref": "#/$defs/isoDate"
    },
    "last_modified": {
      "$ref": "#/$defs/isoDate"
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO calendar date (YYYY-MM-DD); PyYAML date objects are normalized before checking."
    }
  }
}
