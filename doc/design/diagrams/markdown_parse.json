  "cards": [
    {
      "dot": "cyan",
      "title": "Engine chain",
      "items": [
        "pdf_conv_md.py: pymupdf4llm primary, OCR fallbacks, Paddle last",
        "writes <slug>.md + images/ + OKF frontmatter + verify manifest"
      ]
    },
    {
      "dot": "emerald",
      "title": "Curation safety",
      "items": [
        "Stage 5 is the only manual step (worklist-driven)",
        "auto chatter blocks are sentinel-wrapped, never clobber hand ones",
        "sources[] spliced via backfill_okf_provenance / PRE_FULL"
      ]
    },
    {
      "dot": "rose",
      "title": "Idempotence & sync",
      "items": [
        "relations dedupe on UNIQUE(source, target, edge_type)",
        "derive rows DELETE-then-INSERT on source_ref LIKE 'derive:%'",
        "capture resumable; okf converger no-op once converged"
      ]
    }
  ]
