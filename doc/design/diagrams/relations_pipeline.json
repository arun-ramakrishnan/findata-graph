{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Relations pipeline — extract, triage, apply",
    "quality_profile": "standard",
    "locale": "en",
    "output": "doc/design/diagrams/relations_pipeline.html"
  },
  "lanes": [
    {
      "id": "auto",
      "label": "Automated"
    },
    {
      "id": "human",
      "label": "Human triage"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "Extract",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "p2",
      "label": "Queue",
      "fromCol": 1,
      "toCol": 1
    },
    {
      "id": "p3",
      "label": "Triage",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "p4",
      "label": "Apply",
      "fromCol": 4,
      "toCol": 4
    },
    {
      "id": "p5",
      "label": "Close the loop",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "extract",
    "graph_edges"
  ],
  "nodes": [
    {
      "id": "extract",
      "lane": "auto",
      "col": 0,
      "type": "backend",
      "label": "extract_relations --apply",
      "tag": "walk · prose → edges · noise-gated",
      "width": 170
    },
    {
      "id": "graph_edges",
      "lane": "auto",
      "col": 2,
      "type": "database",
      "label": "graph_edges",
      "tag": "UNIQUE dedupe · symmetric=1",
      "width": 165
    },
    {
      "id": "followup",
      "lane": "auto",
      "col": 5,
      "type": "backend",
      "label": "follow-up chain",
      "tag": "re-extract → roster sync → rebuild",
      "width": 175
    },
    {
      "id": "sidecar",
      "lane": "human",
      "col": 1,
      "type": "database",
      "label": "_pending_relations.txt",
      "tag": "prose misses · suggestions split",
      "width": 175
    },
    {
      "id": "triage",
      "lane": "human",
      "col": 2,
      "type": "backend",
      "label": "make triage-relations",
      "tag": "dedupe · split · bucket",
      "width": 175
    },
    {
      "id": "annotate",
      "lane": "human",
      "col": 3,
      "type": "external",
      "label": "decide per row",
      "tag": "discard · alias · stub · skip · accept",
      "width": 200
    },
    {
      "id": "apply",
      "lane": "human",
      "col": 4,
      "type": "backend",
      "label": "--apply-decisions",
      "tag": "aliases → json · accepts → edges",
      "width": 175
    }
  ],
  "edges": [
    {
      "id": "e-known",
      "from": "extract",
      "to": "graph_edges",
      "role": "main",
      "label": "known targets"
    },
    {
      "id": "e-miss",
      "from": "extract",
      "to": "sidecar",
      "role": "branch",
      "label": "non-noise misses"
    },
    {
      "id": "e-prose",
      "from": "sidecar",
      "to": "triage",
      "role": "main",
      "label": "prose rows"
    },
    {
      "id": "e-bucket",
      "from": "triage",
      "to": "annotate",
      "role": "main",
      "label": "bucketed decisions"
    },
    {
      "id": "e-annot",
      "from": "annotate",
      "to": "apply",
      "role": "main",
      "label": "annotated jsonl"
    },
    {
      "id": "e-accept",
      "from": "apply",
      "to": "graph_edges",
      "role": "main",
      "label": "accept:s edges"
    },
    {
      "id": "e-follow",
      "from": "apply",
      "to": "followup",
      "role": "main",
      "label": "when stubs/aliases applied"
    },
    {
      "id": "e-loop",
      "from": "followup",
      "to": "graph_edges",
      "role": "return",
      "label": "re-extract resolves stubs"
    }
  ],
  "cards": [
    {
      "dot": "slate",
      "title": "Evidence origin/main e37eb7db",
      "items": [
        "extract: helpers/graph/extract_relations.py:100 noise gate · :110 sidecar",
        "triage: helpers/graph/triage_pending_relations.py:234 bucket · :487 accept",
        "G3 persist: triage_pending_relations.py:599 · suggestions: :618"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sidecar contract + G3 noise gate",
      "items": [
        "dry-run writes only the sidecar, zero edges; queue is append-on-miss, deduped",
        "noise never enters: countries/generic/fragment filtered at extract write time",
        "G3: discards persist to relation_noise.json — extract consults it, rows do not return",
        "triage splits link-prediction rows → _pending_suggestions.txt (never auto-applied)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Decision buckets (v2)",
      "items": [
        "discard | skip | stub | alias:<Entity> | accept:<edge_type>[:Target]",
        "word-overlap alias candidates carry a _confirm?_ marker (false-positive family)",
        "accept writes (source, target, edge_type) with source_ref='triage:accept'"
      ]
    },
    {
      "dot": "rose",
      "title": "Loop closure",
      "items": [
        "symmetric=1 stored rows: jv_with · same_group · competes_with · co_mentioned_in · semantic_peer",
        "aliases persist to relation_aliases.json (runtime-loaded — no code edits)",
        "after stubs/aliases: re-run extract → roster sync if stubs → graph-rebuild → snapshot"
      ]
    }
  ]
}
