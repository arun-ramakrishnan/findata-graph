  "cards": [
    {
      "dot": "cyan",
      "title": "Apply order",
      "items": [
        "Guard first: --restore refuses to clobber live DBs without --force",
        "SQLite tmp-build: DDL → parquet rows → FTS5 rebuild → FK check → atomic replace",
        "DuckDB: creation-ordered DDL + views, read_parquet bulk load, CHECKPOINT"
      ]
    },
    {
      "dot": "amber",
      "title": "Trust + bounds",
      "items": [
        "Vault notes are never mutated — only the note_search index is rebuilt from the exported shadow",
        "foreign_key_check hard-fails a bad SQLite restore (helpers/maintenance/snapshot_db.py:976)",
        "Restore: _cmd_restore :1034 · sqlite :935 · duckdb :989 · verify_parquet_snapshot :867 · Makefile snapshot-restore :128 — all pinned origin/main 56926513"
      ]
    }
  ]
