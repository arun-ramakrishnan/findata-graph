  "cards": [
    {
      "dot": "cyan",
      "title": "What a create stamps (snapshot_db.py)",
      "items": [
        "pools: research.db, graph.duckdb, embed_store, corpus.db",
        "parquet exports + binary snapshots, zstd twins in db-backup/",
        "embed matrix excluded by design — zstd twins are the recovery points"
      ]
