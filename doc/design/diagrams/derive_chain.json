  "cards": [
    {
      "dot": "cyan",
      "title": "Idempotence (P3 suite)",
      "items": [
        "extract_relations.py → derive_events.py → derive_insights.py → derive_cited_in.py",
        "edges dedupe on UNIQUE(source, target, edge_type)",
        "derive rows are DELETE-then-INSERT on source_ref LIKE 'derive:%'",
        "cited_in is INSERT OR IGNORE — no-op between ingests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Curation safety",
      "items": [
        "auto chatter blocks are sentinel-wrapped; hand-written blocks never clobbered",
        "sidecar _pending_relations.txt catches unknown targets for triage",
        "maint-full runs derive_insights --no-notes: notes mutate only on explicit --apply",
        "derive_insights also reads edition text, not just concall sections"
      ]
    },
    {
      "dot": "rose",
      "title": "Ordering",
      "items": [
        "PRE_FULL runs derive_cited-in ahead of graph-rebuild",
        "derive_events promotes edges AFTER extract re-runs",
        "executable spec: tests/test_integration_derive_chain.py"
      ]
    }
  ]
