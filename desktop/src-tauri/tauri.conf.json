{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "findata-graph",
  "version": "0.1.0",
  "identifier": "io.findata.graph",
  "build": {
    "beforeDevCommand": "npm --prefix src-vue run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix src-vue run build",
    "frontendDist": "../src-vue/dist"
  },
  "app": {
    "windows": [
      {
        "title": "findata-graph",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Business",
    "shortDescription": "Local-first viewer for the findata knowledge graph",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
