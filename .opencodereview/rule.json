{
  "include": [
    "tests/**/*.py",
    "helpers/**/*.py",
    "app.py",
    "desktop/**/*.py",
    "bench_data/**/*.py",
    "Mojo/src/**/*.mojo",
    "Mojo/tests/**/*.mojo",
    "doc/procedures/**",
    "doc/improvements/**"
  ],
  "exclude": [
