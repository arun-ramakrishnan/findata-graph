{
  // coc.nvim workspace settings (loaded automatically when vim opens this repo).
  // Python -> pyright (coc-pyright) pinned to the project venv.
  // Markdown -> marksman (custom server, binary at ~/.local/bin/marksman).
  "python": {
    "venvPath": ".",
    "venv": ".venv",
    "analysis": {
      "autoSearchPaths": true,
      "useLibraryCodeForTypes": true,
      "typeCheckingMode": "basic",
      "diagnosticMode": "openFilesOnly"
    }
  },
  "languageserver": {
    "marksman": {
      "command": "marksman",
      "filetypes": ["markdown"],
      "rootPatterns": [".git", ".marksman.toml"]
    }
  }
}
